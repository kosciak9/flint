#!/bin/bash
# flint-grub-setup: Configure GRUB for Flint
# - Adds grub_class to BLS entries for icons
# - Sets up user.cfg with theme, timeout, default, and Windows entry
# Runs on boot and after deployments (ostree regenerates BLS entries)

set -euo pipefail

BOOT_LOADER_ENTRIES="/boot/loader/entries"
GRUB_USER_CFG="/boot/grub2/user.cfg"
GRUB_THEME_DIR="/boot/grub2/themes/kanagawa"

# Add grub_class to all ostree BLS entries for icon support
inject_grub_class() {
    for entry in "$BOOT_LOADER_ENTRIES"/ostree-*.conf; do
        [[ -f "$entry" ]] || continue
        if ! grep -q '^grub_class' "$entry"; then
            echo "grub_class flint" >> "$entry"
        fi
    done
}

# Create/update user.cfg with theme and Windows entry
setup_user_cfg() {
    cat > "$GRUB_USER_CFG" << 'EOF'
# Flint GRUB Configuration
# Auto-generated by flint-grub-setup

# Timeout (seconds)
set timeout=20

# Default to Flint (first BLS entry after sorting)
set default="Flint (ostree:1)"

# Graphics mode for Framework 13 (2560x1600)
set gfxmode=2560x1600x32,2560x1600,1920x1200,auto
set gfxpayload=keep

# Load graphics modules
insmod all_video
insmod gfxterm
terminal_output gfxterm

# Kanagawa theme
insmod png
set theme=/boot/grub2/themes/kanagawa/theme.txt

# AtlasOS (Windows) - loaded after blscfg via submenu trick
# Note: This appears before BLS entries due to grub.cfg order
# but default is set to Flint above
menuentry "AtlasOS" --class windows --class os {
    insmod part_gpt
    insmod fat
    search --no-floppy --fs-uuid --set=root BAFB-52E8
    chainloader /EFI/Microsoft/Boot/bootmgfw.efi
}
EOF
}

# Main
echo "flint-grub-setup: Configuring GRUB..."

inject_grub_class
echo "  - Injected grub_class into BLS entries"

setup_user_cfg
echo "  - Created user.cfg with theme and settings"

echo "flint-grub-setup: Done"
